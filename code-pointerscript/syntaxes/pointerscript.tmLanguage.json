{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "PointerScript",
	"scopeName": "source.pointerscript",
	"fileTypes": [
		"ptrs"
	],
	"patterns": [
		{
			"include": "#import"
		},
		{
			"include": "#keyword"
		},
		{
			"include": "#shebang"
		},
		{
			"include": "#comment"
		},
		{
			"include": "#string"
		},
		{
			"include": "#number"
		},
		{
			"include": "#operator"
		},
		{
			"include": "#builtin-constant"
		},
		{
			"include": "#type"
		},
		{
			"include": "#call"
		},
		{
			"include": "#identifier"
		},
		{
			"include": "#punctuation"
		}
	],
	"repository": {
		"shebang": {
			"patterns": [
				{
					"name": "comment.block.shebang.pointerscript",
					"match": "^#!.*$"
				}
			]
		},
		"comment": {
			"patterns": [
				{
					"name": "comment.line.double-slash.pointerscript",
					"begin": "//",
					"end": "$"
				},
				{
					"name": "comment.block.pointerscript",
					"begin": "/\\*",
					"end": "\\*/"
				}
			]
		},
		"string": {
			"patterns": [
				{
					"name": "string.quoted.double.pointerscript",
					"begin": "\"",
					"end": "\"",
					"patterns": [
						{
							"include": "#escaped"
						},
						{
							"include": "#string-interpolation"
						},
						{
							"include": "#string-placeholder"
						}
					]
				},
				{
					"name": "string.quoted.single.pointerscript",
					"begin": "'",
					"end": "'",
					"patterns": [
						{
							"include": "#escaped"
						}
					]
				},
				{
					"name": "string.quoted.backtick.pointerscript",
					"begin": "`",
					"end": "`",
					"patterns": [
						{
							"include": "#string-interpolation"
						},
						{
							"include": "#string-placeholder"
						}
					]
				}
			]
		},
		"escaped": {
			"patterns": [
				{
					"name": "constant.character.escape.pointerscript",
					"match": "\\\\."
				}
			]
		},
		"string-interpolation": {
			"name": "meta.template.expression.pointerscript",
			"begin": "(?x) \\$(%\n(\\d+\\$)?\t\t\t\t\t\t   # field (argument #)\n[#0\\- +']*\t\t\t\t\t\t  # flags\n[,;:_]?\t\t\t\t\t\t\t  # separator character (AltiVec)\n((-?\\d+)|\\*(-?\\d+\\$)?)?\t\t  # minimum field width\n(\\.((-?\\d+)|\\*(-?\\d+\\$)?)?)?\t# precision\n(hh|h|ll|l|j|t|z|q|L|vh|vl|v|hv|hl)? # length modifier\n[diouxXDOUeEfFgGaACcSspn%]\t\t   # conversion type\n)?\\{",
			"beginCaptures": {
				"0": {
					"name": "punctuation.definition.template-expression.begin.pointerscript"
				},
				"1": {
					"name": "constant.other.placeholder.pointerscript"
				}
			},
			"end": "\\}",
			"endCaptures": {
				"0": {
					"name": "punctuation.definition.template-expression.end.pointerscript"
				}
			},
			"patterns": [
				{
					"include": "$self"
				}
			],
			"contentName": "meta.embedded.line.pointerscript"
		},
		"string-placeholder": {
			"patterns": [
				{
					"match": "(?x) %\n(\\d+\\$)?\t\t\t\t\t\t   # field (argument #)\n[#0\\- +']*\t\t\t\t\t\t  # flags\n[,;:_]?\t\t\t\t\t\t\t  # separator character (AltiVec)\n((-?\\d+)|\\*(-?\\d+\\$)?)?\t\t  # minimum field width\n(\\.((-?\\d+)|\\*(-?\\d+\\$)?)?)?\t# precision\n(hh|h|ll|l|j|t|z|q|L|vh|vl|v|hv|hl)? # length modifier\n[diouxXDOUeEfFgGaACcSspn%]\t\t   # conversion type",
					"name": "constant.other.placeholder.pointerscript"
				},
				{
					"match": "(%)(?!\"\\s*(PRI|SCN))",
					"captures": {
						"1": {
							"name": "invalid.illegal.placeholder.pointerscript"
						}
					}
				}
			]
		},
		"number": {
			"patterns": [
				{
					"name": "constant.numeric.pointerscript",
					"match": "[+-]?\\b(0x[0-9a-fA-F]+|0[0-7]*|[1-9]\\d*(?:\\.\\d+)?(?:e[+-]?\\d+)?[fF]?|0(?:\\.\\d+)(?:e[+-]?\\d+)?[fF]?|0[fF]?)\\b"
				}
			]
		},
		"keyword": {
			"patterns": [
				{
					"name": "keyword.control.pointerscript",
					"match": "\\b(break|continue|delete|throw|try|catch|finally|function|struct|switch|if|else|loop|while|do|for|foreach|return|import|as|in|from|var|const|sizeof|new|new_stack|operator|constructor|destructor|private|public|internal|static|get|set|default|case|instanceof|type|typeof|map|map_stack|cast|throw|this)\\b"
				}
			]
		},
		"import": {
			"patterns": [
				{
					"beginCaptures": {
						"1": {
							"name": "keyword.control.pointerscript"
						}
					},
					"begin": "\\b(import)\\b",
					"end": ";",
					"patterns": [
						{
							"include": "#keyword"
						},
						{
							"include": "#import-variable"
						},
						{
							"include": "#import-function"
						},
						{
							"include": "$self"
						}
					]
				}
			]
		},
		"import-function": {
			"patterns": [
				{
					"name": "entity.name.function.pointerscript",
					"match": "\\b[_a-zA-Z][_a-zA-Z0-9]*\\b"
				}
			]
		},
		"import-variable": {
			"patterns": [
				{
					"match": "\\b(?:([_a-zA-Z][_a-zA-Z0-9]*)|\\*)\\s*:\\s*(\\w+)(?:\\s+(as)\\s+([_a-zA-Z][_a-zA-Z0-9]*))?\\b",
					"captures": {
						"1": {
							"name": "variable.name.constant.pointerscript"
						},
						"2": {
							"patterns": [
								{
									"include": "#type"
								}
							]
						},
						"3": {
							"name": "keyword.control.pointerscript"
						},
						"4": {
							"name": "variable.name.constant.pointerscript"
						}
					}
				}
			]
		},
		"operator": {
			"patterns": [
				{
					"name": "keyword.operator.pointerscript",
					"match": "(===|!==|==|!=|<=|>=|<<=|>>=|\\+\\+|--|\\+=|-=|\\*=|/=|%=|>>|<<|&&|\\|\\||\\^\\^|\\||\\^|&|=|\\?|:|\\+|\\-|\\*|/|%|!|~|\\.|,)"
				}
			]
		},
		"type": {
			"patterns": [
				{
					"name": "storage.type.builtin.pointerscript",
					"match": "\\b(undefined|int|float|pointer|struct|function)\\b"
				},
				{
					"name": "storage.type.native.pointerscript",
					"match": "\\b(char|short|int|long|longlong|uchar|ushort|uint|ulong|ulonglong|i8|i16|i32|i64|u8|u16|u32|u64|float|double|f32|f64|cfunc|pointer|bool|ssize|size|intptr|uintptr|ptrdiff|var)\\b"
				}
			]
		},
		"builtin-constant": {
			"patterns": [
				{
					"name": "constant.language.pointerscript",
					"match": "\\b(true|false|null|undefined|NaN|Infinity|PI|E)\\b"
				}
			]
		},
		"call": {
			"patterns": [
				{
					"begin": "\\b([_a-zA-Z][_a-zA-Z0-9]*)\\b\\s*(\\()",
					"end": "\\)",
					"beginCaptures": {
						"1": {
							"name": "entity.name.function.pointerscript"
						}
					},
					"patterns": [
						{
							"include": "$self"
						}
					]
				}
			]
		},
		"identifier": {
			"patterns": [
				{
					"name": "variable.other.pointerscript",
					"match": "\\b[_a-zA-Z][_a-zA-Z0-9]*\\b"
				}
			]
		},
		"punctuation": {
			"patterns": [
				{
					"name": "punctuation.terminator.statement.pointerscript",
					"match": ";"
				},
				{
					"name": "punctuation.separator.parameter.pointerscript",
					"match": ","
				},
				{
					"name": "punctuation.section.block.begin.pointerscript",
					"match": "\\{"
				},
				{
					"name": "punctuation.section.block.end.pointerscript",
					"match": "\\}"
				},
				{
					"name": "punctuation.section.group.begin.pointerscript",
					"match": "\\("
				},
				{
					"name": "punctuation.section.group.end.pointerscript",
					"match": "\\)"
				},
				{
					"name": "punctuation.section.array.begin.pointerscript",
					"match": "\\["
				},
				{
					"name": "punctuation.section.array.end.pointerscript",
					"match": "\\]"
				}
			]
		}
	}
}